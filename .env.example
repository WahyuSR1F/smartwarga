# ===========================================
# Smart Warga RT/RW - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# --- Database (Turso/LibSQL) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Authentication (Local) ---
JWT_SECRET=

# --- App Config ---
VITE_APP_ID=
PORT=3000

# --- Analytics (Umami) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- SEO ---
CANONICAL_ORIGIN=
SITE_NAME=Smart Warga

# --- Supabase Storage (optional) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Integration (optional) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Forge API (optional) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Vercel (production) ---
# Protects /api/cron/* endpoints (set in Vercel project settings)
CRON_SECRET=
# Set to 1 to disable Socket.IO (automatic on serverless builds)
DISABLE_REALTIME=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:client && pnpm run build:api",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "functions": {
    "api/index.cjs": {
      "includeFiles": "api/shell.html"
    },
    "api/seo.cjs": {
      "includeFiles": "api/shell.html"
    }
  },
  "crons": [
    {
      "path": "/api/cron/event-reminder",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/trpc/:path*", "destination": "/api/index" },
    { "source": "/api/whatsapp/webhook", "destination": "/api/index" },
    { "source": "/robots.txt", "destination": "/api/index" },
    { "source": "/sitemap.xml", "destination": "/api/index" },
    { "source": "/manus-storage/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/api/seo" }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
